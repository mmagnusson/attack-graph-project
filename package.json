{
  "name": "attackbreaker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "tsx scripts/build-attack-data.ts",
    "check": "tsc -b && eslint . && vitest run",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "data:d3fend": "tsx scripts/build-d3fend-data.ts",
    "data:evals": "tsx scripts/build-evals-coverage.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.77.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
